    values:
    - m_language:
        m_address:
          m_low: 8319415704751845611
          m_high: -6023042414290333943
      title: "\u94C1\u6273\u624B"
      description: "\u5F3A\u529B\u5DE5\u5177\uFF0C\u53EF\u7528\u4E8E\u5B89\u88C5
        and \u62C6\u5378\u673A\u68B0\u8BBE\u5907\u3002\u8986\u76D6\u591A\u8FBE2x2\u683C\u7684\u533A\u57DF\u3002"
    - m_language:
        m_address:
          m_low: -2957573344710624914
          m_high: 6297677370195620808
      title: "\u9435\u6273\u624B"
      description: "\u5F37\u529B\u5DE5\u5177\uFF0C\u53EF\u7528\u65BC\u5B89\u88DD\u548C\u62C6\u5378\u6A5F\u68B0\u8A2D\u5099\u3002\u8986\u84CB\u591A\u90542x2\u683C\u7684\u5340\u57DF\u3002"
    - m_language:
        m_address:
          m_low: 681352171529052915
          m_high: 2314507893210082619
      title: Iron Wrench
      description: A strong tool that can mount and unmount machinery and equipment.
        Covers an area of up to 2x2 tiles.
    - m_language:
        m_address:
          m_low: 6040640903323332866
          m_high: 4472318406855671320
      title: "Cl\xE9 en fer"
      description: "Un outil robuste permettant de monter et d\xE9monter les machines
        et \xE9quipements. Couvre une zone allant jusqu'\xE0 2x2 cases."
    - m_language:
        m_address:
          m_low: 5554070574462901973
          m_high: -3923471906115629047
      title: "Eisenschraubenschl\xFCssel"
      description: Ein robustes Werkzeug zum Auf- und Abbauen von Maschinen und Anlagen.
        Deckt einen Bereich von bis zu 2x2 Kacheln ab.
    - m_language:
        m_address:
          m_low: 4644340974835219079
          m_high: -8672482724880852038
      title: Chiave di ferro
      description: Uno strumento robusto per montare e smontare macchinari e attrezzature.
        Copre un'area fino a 2x2 tessere.
    - m_language:
        m_address:
          m_low: -7722434995445778156
          m_high: 2655981564484923289
      title: "\u9244\u306E\u30EC\u30F3\u30C1"
      description: "\u673A\u68B0\u3084\u8A2D\u5099\u3092\u8A2D\u7F6E\u30FB\u89E3\u4F53\u3067\u304D\u308B\u5F37\u529B\u306A\u5DE5\u5177\u3002\u6700\u59272x2\u30DE\u30B9\u306E\u7BC4\u56F2\u3092\u30AB\u30D0\u30FC\u3057\u307E\u3059\u3002"
    - m_language:
        m_address:
          m_low: -2052239290651699458
          m_high: -8389256263833660117
      title: "\uCCA0\uC81C \uB80C\uCE58"
      description: "\uAE30\uACC4 \uBC0F \uC7A5\uBE44\uB97C \uC124\uCE58\uD558\uACE0
        \uD574\uC81C\uD560 \uC218 \uC788\uB294 \uAC15\uB825\uD55C \uACF5\uAD6C\uC785\uB2C8\uB2E4.
        \uCD5C\uB300 2x2 \uD0C0\uC77C\uC758 \uBC94\uC704\uB97C \uCEE4\uBC84\uD569\uB2C8\uB2E4."
    - m_language:
        m_address:
          m_low: 7851011593462244222
          m_high: 4794823751170882376
      title: Chave de Ferro
      description: "Uma ferramenta forte capaz de montar e desmontar m\xE1quinas
        e equipamentos. Cobre uma \xE1rea de at\xE9 2x2 blocos."
    - m_language:
        m_address:
          m_low: -998452581336238672
          m_high: -1236628366252422438
      title: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u0433\u0430\u0435\u0447\u043D\u044B\u0439
        \u043A\u043B\u044E\u0447"
      description: "\u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
        \u0434\u043B\u044F \u043C\u043E\u043D\u0442\u0430\u0436\u0430 \u0438 \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436\u0430
        \u043C\u0430\u0448\u0438\u043D \u0438 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F.
        \u041E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043E\u0431\u043B\u0430\u0441\u0442\u044C
        \u0434\u043E 2x2 \u043A\u043B\u0435\u0442\u043E\u043A."
    - m_language:
        m_address:
          m_low: 555117963105384372
          m_high: 3194402766475108890
      title: Llave de hierro
      description: "Una herramienta resistente para montar y desmontar maquinaria
        y equipos. Cubre un \xE1rea de hasta 2x2 casillas."
    - m_language:
        m_address:
          m_low: 7837645069971566515
          m_high: 4238944138262099067
      title: "\u0E1B\u0E23\u0E30\u0E41\u0E08\u0E40\u0E2B\u0E25\u0E47\u0E01"
      description: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E21\u0E37\u0E2D\u0E17\u0E35\u0E48\u0E41\u0E02\u0E47\u0E07\u0E41\u0E01\u0E23\u0E48\u0E07
        \u0E43\u0E0A\u0E49\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E15\u0E34\u0E14\u0E15\u0E31\u0E49\u0E07\u0E41\u0E25\u0E30\u0E16\u0E2D\u0E14\u0E1B\u0E23\u0E30\u0E01\u0E2D\u0E1A\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E08\u0E31\u0E01\u0E23\u0E41\u0E25\u0E30\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C
        \u0E04\u0E23\u0E2D\u0E1A\u0E04\u0E25\u0E38\u0E21\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14
        2x2 \u0E0A\u0E48\u0E2D\u0E07"
    - m_language:
        m_address:
          m_low: 7031320391619404414
          m_high: 5017443214120506826
      title: "\u0417\u0430\u043B\u0456\u0437\u043D\u0438\u0447\u043D\u0438\u0439
        \u043A\u043B\u044E\u0447"
      description: "\u041C\u0456\u0446\u043D\u0438\u0439 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
        \u0434\u043B\u044F \u043C\u043E\u043D\u0442\u0430\u0436\u0443 \u0442\u0430
        \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436\u0443 \u043C\u0430\u0448\u0438\u043D
        \u0456 \u043E\u0431\u043B\u0430\u0434\u043D\u0430\u043D\u043D\u044F. \u041E\u0445\u043E\u043F\u043B\u044E\u0454
        \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u0440\u043E\u0437\u043C\u0456\u0440\u043E\u043C
        \u0434\u043E 2x2 \u043F\u043B\u0438\u0442\u043E\u043A."
